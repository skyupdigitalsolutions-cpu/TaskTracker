{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasktracker",
  "compatibility_date": "2026-08-14",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "task-tracker",
      "database_id": "93c6a556-6ac1-4bc0-aa97-6f0ddcf82e69"
    }
  ]
}
